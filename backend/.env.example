# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend CORS Configuration
# Comma-separated list of allowed origins for CORS
# For development: http://localhost:5173,http://localhost:5174
# For production: https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL_CORS_ALLOWED=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Legacy frontend URL (if needed for other purposes)
FRONTEND_URL=http://localhost:5173

# Google Workspace Integration (Optional)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./scanx-468705-b3849805bd57.json
# GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@yourdomain.com
# GOOGLE_WORKSPACE_CUSTOMER=my_customer

ENABLE_REGISTER_ENDPINT=