# Server Configuration
PORT=3000
NODE_ENV=development

# Winston log level: error | warn | info | verbose | debug | silly
LOG_LEVEL=info

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend CORS Configuration
# Comma-separated list of allowed origins for CORS
# For development: http://localhost:5173,http://localhost:5174
# For production: https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL_CORS_ALLOWED=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Legacy frontend URL (if needed for other purposes)
FRONTEND_URL=http://localhost:5173

# Google Workspace Integration (Optional)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./scanx-468705-b3849805bd57.json
# GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@yourdomain.com
# GOOGLE_WORKSPACE_CUSTOMER=my_customer
# Optional: org unit path substring — new directory users in matching OUs insert as service (existing rows unchanged)
# GOOGLE_SERVICE_ORG_UNIT_PATH=/Service Accounts

ENABLE_REGISTER_ENDPOINT=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Comma-separated email domains never deactivated by Google directory sync (omit to default to octro.com only; default is logged at sync time)
USER_SYNC_PROTECTED_EMAIL_DOMAINS=

# Device purge worker (Redis list key, batch size, poll interval ms)
DEVICE_PURGE_QUEUE_KEY=scanx:device_purge
DEVICE_PURGE_DEVICE_BATCH=5
DEVICE_PURGE_WORKER_POLL_MS=60000 # 1 minute

SMTP_HOST=localhost
SMTP_PORT=
SMTP_FROM=
SMTP_SECURE=