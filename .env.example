# Observability stack (OpenObserve + OpenTelemetry Collector).
#
# Copy to .env and fill in real values before `docker compose up`:
#   cp .env.example .env
#
# OO_AUTH_HEADER authenticates both the backend log shipper and the collector
# to OpenObserve. It must be
# the base64 of "<email>:<password>" for the root user below, prefixed "Basic ".
# Regenerate it whenever the password changes:
#   printf '%s:%s' "$OO_ROOT_USER_EMAIL" "$OO_ROOT_USER_PASSWORD" | base64

OO_ROOT_USER_EMAIL=root@example.com
OO_ROOT_USER_PASSWORD=change-me
OO_ORG=default
OO_PORT=5080
OO_AUTH_HEADER=Basic cm9vdEBleGFtcGxlLmNvbTpjaGFuZ2UtbWU=
OO_RETENTION_DAYS=30
# Log stream the backend writes to. Renaming this creates a new stream; note
# that deleting a stream in OpenObserve is asynchronous, so a deleted name
# stays un-ingestable until its background delete finishes.
OO_STREAM=scanx_backend_logs
OO_LOGS_ENABLED=true
# In-container URL, used by the backend via docker-compose. Leave as the service
# name; setting this to localhost breaks log shipping from inside the container.
OO_ENDPOINT=http://openobserve:5080
# Host-side URL, used by scripts/container-health.sh which runs outside docker.
OO_HOST_ENDPOINT=http://localhost:5080
# Host docker group id, so the collector can read /var/run/docker.sock.
# Find it with: getent group docker    (macOS/Docker Desktop: leave 0)
DOCKER_GID=0
