# Observability stack (OpenObserve + OpenTelemetry Collector).
#
# Copy to .env and fill in real values before `docker compose up`:
#   cp .env.example .env
#
# OO_AUTH_HEADER is how the collector authenticates to OpenObserve. It must be
# the base64 of "<email>:<password>" for the root user below, prefixed "Basic ".
# Regenerate it whenever the password changes:
#   printf '%s:%s' "$OO_ROOT_USER_EMAIL" "$OO_ROOT_USER_PASSWORD" | base64

OO_ROOT_USER_EMAIL=root@example.com
OO_ROOT_USER_PASSWORD=change-me
OO_ORG=default
OO_PORT=5080
OO_AUTH_HEADER=Basic cm9vdEBleGFtcGxlLmNvbTpjaGFuZ2UtbWU=
OO_RETENTION_DAYS=30
# Host docker group id, so the collector can read /var/run/docker.sock.
# Find it with: getent group docker    (macOS/Docker Desktop: leave 0)
DOCKER_GID=0
